+// Only selected for a statically proven nonzero signed power-of-two divisor.
+// Unsigned magnitudes also cover INT64_MIN and the protected MIN / -1 wrap.
+__device__ inline long long d_static_pow2_divmod(long long a,long long b,bool modulo) {
+  const auto numerator=a<0?0ULL-static_cast<unsigned long long>(a):static_cast<unsigned long long>(a);
+  const auto divisor=b<0?0ULL-static_cast<unsigned long long>(b):static_cast<unsigned long long>(b);
+  if(!modulo) {
+    const auto quotient=numerator >> (__ffsll(static_cast<long long>(divisor))-1);
+    return static_cast<long long>((a<0)!=(b<0)?0ULL-quotient:quotient);
+  }
+  const auto magnitude=numerator&(divisor-1);
+  auto remainder=static_cast<long long>(a<0?0ULL-magnitude:magnitude);
+  if(remainder && (a<0)!=(b<0))remainder=vm_semantics::wrap_int_add(remainder,b);
+  return remainder;
+}
