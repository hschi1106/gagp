<!doctype html>
<html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>GAGP G64 results</title><style>
*{box-sizing:border-box}body{margin:0;font:14px/1.55 system-ui,sans-serif;color:var(--foreground,#111);background:transparent}h2{font-size:21px;margin:0 0 8px}h3{font-size:17px;margin:25px 0 9px}p{margin:7px 0}small,.muted{color:var(--muted-foreground,#555)}.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:18px 0}.metric{border-top:2px solid currentColor;padding-top:8px}.number{font-size:30px;line-height:1.3;font-variant-numeric:tabular-nums}.label{font-size:12px}.controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0}input,select,button{font:inherit;background:var(--background,#fff);color:inherit;border:1px solid var(--border,#999);border-radius:3px;padding:6px;min-width:0;max-width:100%}select{flex:1 1 180px}input[type=search]{flex:1 1 150px;width:150px}button{cursor:pointer}button[aria-pressed=true]{border:2px solid currentColor;padding:5px;font-weight:600}.chart{width:100%;max-width:100%;display:block}.table{display:grid;gap:0;border-top:1px solid var(--border,#aaa);font-size:12px}.row{display:grid;grid-template-columns:minmax(0,1.4fr) repeat(3,minmax(0,1fr));gap:8px;padding:8px 0;border-bottom:1px solid var(--border,#ddd);align-items:center;overflow-wrap:anywhere}.row>span:not(:first-child){text-align:right;font-variant-numeric:tabular-nums}.head{font-weight:600}.legend{display:flex;gap:15px;font-size:12px}.swatch{display:inline-block;width:24px;border-top:2px solid currentColor;margin-right:5px;vertical-align:middle}.dash{border-top-style:dashed}.notes{padding-left:18px;font-size:12px}.notes li{margin:5px 0}.empty{font-size:13px;padding:16px 0}svg text{font-family:system-ui,sans-serif;fill:currentColor}svg{overflow:hidden}.detail{font-variant-numeric:tabular-nums;font-size:12px}a{color:inherit}#task-status{min-height:20px;font-size:12px}@media(max-width:400px){.number{font-size:25px}.row{gap:5px;font-size:11px}.metrics{gap:12px}}
</style></head><body>
<main>
<h2>GAGP：P1024／64 代</h2>
<p class="muted" id="coverage"></p>
<p class="muted label" id="case-scope"></p>
<div class="metrics"><div class="metric"><div class="number" id="gpu-speed">—</div><div class="label">相對本輪開始時最快 GAGP</div></div><div class="metric"><div class="number" id="asgp-speed">—</div><div class="label">相對本輪新測 ASGP 1T</div></div></div>
<p id="target" class="detail"></p>
<p class="detail" id="quality-summary"></p>
<p class="detail" id="asgp-quality"></p>
<p class="detail" id="search-verification"></p>
<p class="detail" id="verification-costs"></p>
<div class="controls"><label for="task-filter">題目</label><input id="task-filter" type="search" placeholder="Filter tasks" aria-label="Filter tasks"><select id="task-select" aria-label="Select task"></select></div>
<h3>搜尋時間加速比</h3><p class="muted label">舊 GAGP 時間 ÷ 新 GAGP 時間；大於 1 代表變快。包含 GPU 評分與 GPU 繁殖。</p>
<svg id="speed-chart" class="chart" role="img" aria-label="Per-task G64 speedup"></svg>
<h3>品質：每代冠軍的正確率</h3>
<div class="controls"><button id="train-toggle" aria-pressed="false">Training</button><button id="test-toggle" aria-pressed="true">Test</button></div>
<div class="legend"><span><i class="swatch"></i>舊 GAGP</span><span><i class="swatch dash"></i>新 GAGP</span></div>
<svg id="quality-chart" class="chart" role="img" aria-label="Generation champion accuracy"></svg>
<p id="task-status" class="detail"></p>
<h3>題目明細</h3>
<div class="table"><div class="row head"><span>Task</span><span>GAGP<br>speedup</span><span>ASGP／<br>新 GAGP</span><span>解題<br>舊 → 新</span></div><div id="task-rows"></div></div>
<h3>P16384：獨立結果</h3><p id="secondary" class="detail"></p>
<p id="secondary-memory" class="detail"></p>
<p class="muted label">64代，每題1輪。下表沿用題目篩選；「完整」指三方法資料與指定原生核對齊備，解題品質另列。</p>
<div class="table"><div class="row head"><span>Task</span><span>GAGP<br>speedup</span><span>ASGP／<br>新 GAGP</span><span>三方法<br>對照</span></div><div id="secondary-rows"></div></div>
<h3>GPU 執行方式</h3><ul id="methods" class="notes"></ul>
<h3>量測範圍與限制</h3><ul id="notes" class="notes"></ul>
</main>
<script id="study-data" type="application/json">__STUDY_JSON__</script>
<script>
(()=>{'use strict';
const D=JSON.parse(document.getElementById('study-data').textContent),S=D.summary,byId=id=>document.getElementById(id);
const fmt=(v,d=2)=>Number.isFinite(v)?v.toFixed(d):'—',times=v=>Number.isFinite(v)?fmt(v)+'×':'未完成';
byId('gpu-speed').textContent=times(S.primary_speedup);byId('asgp-speed').textContent=times(S.asgp_speedup);
byId('coverage').textContent=`30 題 · P1024 · G64 · ${S.repetitions??3} 次速度重複 · 品質 ${S.seed_count??0} 個新 seeds`;
byId('case-scope').textContent=S.training_case_range?`Training：每題 ${S.training_case_range.join('–')} cases；test：每題最多 1000，有限輸入域較少。`:'Fixture 尚未完整；cases 數見 CSV。';
byId('target').textContent=`目標 1.3×：${S.target_reached?'達到':'未證明達到'}。完整通過速度驗證 ${S.primary_qualified_tasks??0}/30 題。${S.speed_ci95?'三輪配對時間區間 '+S.speed_ci95.map(x=>fmt(x)+'×').join('–')+'。':''}`;
byId('quality-summary').textContent=`GAGP 獨立品質：完整判題 ${S.quality_complete_pairs??0}/${S.quality_expected_pairs??0} 對；最終 train+test 全對：${S.baseline_final_success??0} → ${S.candidate_final_success??0}；初代已全對：${S.baseline_initial_success??0} → ${S.candidate_initial_success??0}；演化後新解：${S.baseline_new_success??0} → ${S.candidate_new_success??0}。`;
byId('asgp-quality').textContent=`ASGP 1T 品質僅速度 cohort 的 seed35：完整判題 ${S.asgp_quality_qualified_tasks??0}/30 題；可確認最終全對 ${S.asgp_final_success??0}/30。`;
byId('search-verification').textContent=`搜尋中 CPU 核對：有記錄 ${S.in_search_cpu_verification_known??0}/${S.post_search_cpu_audit_expected??0} 次 GPU 搜尋；已知 fitness／wrong 修正 ${fmt(S.in_search_cpu_fitness_corrections,0)}／${fmt(S.in_search_cpu_wrong_corrections,0)} 次、best 變更 ${fmt(S.in_search_cpu_best_changes,0)} 次，記錄耗時 ${fmt(S.in_search_cpu_verification_s,3)} 秒。此耗時已包含在搜尋 wall time。`;
byId('verification-costs').textContent=`驗證成本另列：搜尋後 CPU 稽核區段已記錄 ${fmt(S.post_search_cpu_audit_recorded_s,1)} 秒（${S.post_search_cpu_audit_known??0}/${S.post_search_cpu_audit_expected??0} 次 GPU 搜尋）；離線判題 process 已記錄 ${fmt(S.offline_recorded_process_s,1)} 秒，含失敗 ${fmt(S.offline_failed_recorded_process_s,1)} 秒、已開始但成本未知 ${S.offline_unknown_started_costs??0} 筆。這些不是純 CPU 評分時間，也不計入搜尋倍率。`;
byId('secondary').textContent=S.secondary_text||'尚無完整 P16384 正式結果。';
byId('secondary-memory').textContent=S.secondary_memory_text||'尚無完整 P16384 VRAM取樣紀錄。';
for(const text of D.limitations||[]){const li=document.createElement('li');li.textContent=text;byId('notes').append(li)}
for(const text of D.execution_methods||[]){const li=document.createElement('li');li.textContent=text;byId('methods').append(li)}
let split='test',selected='all';
function visible(){const q=byId('task-filter').value.toLowerCase();return D.tasks.filter(r=>r.task.toLowerCase().includes(q))}
function options(){const list=visible(),select=byId('task-select');select.replaceChildren();for(const [v,t] of [['all','All visible tasks'],...list.map(r=>[r.task,r.task])]){const o=document.createElement('option');o.value=v;o.textContent=t;select.add(o)}if(!list.some(r=>r.task===selected))selected='all';select.value=selected}
const NS='http://www.w3.org/2000/svg';
function node(svg,type,attrs,text){const e=document.createElementNS(NS,type);for(const [k,v]of Object.entries(attrs))e.setAttribute(k,v);if(text!==undefined)e.textContent=text;svg.append(e);return e}
function setup(id,h){const svg=byId(id),w=Math.max(260,Math.floor(svg.parentElement.clientWidth));svg.replaceChildren();svg.setAttribute('viewBox',`0 0 ${w} ${h}`);svg.style.height=h+'px';return[svg,w]}
function drawSpeed(rows){const h=rows.length*24+40,[svg,w]=setup('speed-chart',Math.max(64,h)),left=Math.min(145,w*.43),right=w-42;const values=rows.map(r=>r.speedup).filter(v=>Number.isFinite(v)&&v>0);const lo=Math.min(-.15,...values.map(v=>Math.log2(v))),hi=Math.max(Math.log2(1.3),.15,...values.map(v=>Math.log2(v)));const x=v=>left+(Math.log2(v)-lo)/(hi-lo)*(right-left);node(svg,'line',{x1:x(1),x2:x(1),y1:8,y2:h-24,stroke:'currentColor',opacity:.35});node(svg,'line',{x1:x(1.3),x2:x(1.3),y1:8,y2:h-24,stroke:'currentColor','stroke-dasharray':'3 4',opacity:.35});for(let i=0;i<rows.length;i++){const r=rows[i],y=22+i*24;node(svg,'text',{x:0,y,'font-size':10},r.task);if(Number.isFinite(r.speedup)&&r.speedup>0){node(svg,'line',{x1:x(1),x2:x(r.speedup),y1:y-4,y2:y-4,stroke:'currentColor','stroke-width':7,opacity:.7});node(svg,'text',{x:right+5,y,'font-size':10},fmt(r.speedup))}else node(svg,'text',{x:left,y,'font-size':10},'未完成')}node(svg,'text',{x:x(1),y:h-6,'text-anchor':'middle','font-size':10},'1×');node(svg,'text',{x:x(1.3),y:h-6,'text-anchor':'middle','font-size':10},'1.3×')}
function curve(rows,variant){const arrays=rows.map(r=>r.curves?.[variant]?.[split]).filter(a=>Array.isArray(a)&&a.length===65);if(!arrays.length)return null;return Array.from({length:65},(_,i)=>arrays.reduce((s,a)=>s+a[i],0)/arrays.length)}
function drawQuality(rows){const [svg,w]=setup('quality-chart',235),left=32,right=w-12,top=12,bottom=205,x=i=>left+i/64*(right-left),y=v=>bottom-v*(bottom-top);for(const t of [0,.5,1]){node(svg,'line',{x1:left,x2:right,y1:y(t),y2:y(t),stroke:'currentColor',opacity:.15});node(svg,'text',{x:left-5,y:y(t)+4,'text-anchor':'end','font-size':10},Math.round(t*100)+'%')}for(const t of [0,16,32,48,64])node(svg,'text',{x:x(t),y:225,'text-anchor':'middle','font-size':10},String(t));let any=false;for(const v of ['baseline','candidate']){const a=curve(rows,v);if(!a)continue;any=true;node(svg,'polyline',{points:a.map((n,i)=>`${x(i)},${y(n)}`).join(' '),fill:'none',stroke:'currentColor','stroke-width':v==='baseline'?2.8:1.6,'stroke-dasharray':v==='candidate'?'6 4':'none',opacity:v==='baseline'?.5:1})}if(!any)node(svg,'text',{x:left+10,y:110,'font-size':12},'尚無完整逐代品質結果')}
function renderSecondary(rows){
  const tasks=new Set(rows.map(r=>r.task));
  byId('secondary-rows').replaceChildren();
  for(const r of D.secondary_tasks||[]){
    if(!tasks.has(r.task))continue;
    const div=document.createElement('div');div.className='row';
    div.title=`GAGP: ${(r.statuses||[]).join(' / ')}; ASGP: ${r.asgp_status??'unknown'}`;
    for(const value of [r.task,times(r.speedup),times(r.asgp_over_candidate),r.complete?'完整':'未完整']){
      const span=document.createElement('span');span.textContent=value;div.append(span);
    }
    byId('secondary-rows').append(div);
  }
}
function render(){
  const visibleRows=visible(),rows=selected==='all'?visibleRows:visibleRows.filter(r=>r.task===selected);
  drawSpeed(rows);drawQuality(rows);byId('task-rows').replaceChildren();
  for(const r of rows){
    const div=document.createElement('div');div.className='row';
    for(const value of [r.task,times(r.speedup),times(r.asgp_over_candidate),`${r.baseline_success??0} → ${r.candidate_success??0} / ${r.quality_expected??0}`]){
      const span=document.createElement('span');span.textContent=value;div.append(span);
    }
    byId('task-rows').append(div);
  }
  renderSecondary(rows);
  byId('task-status').textContent=selected==='all'?`${rows.length} 題；曲線為有完整判題資料的各題 seed 平均，再對題目取平均。`:(rows.length?`${rows[0].quality_complete??0}/${rows[0].quality_expected??0} 對完整判題。`:'No matching tasks');
  document.documentElement.dataset.split=split;document.documentElement.dataset.task=selected;
}
byId('task-filter').addEventListener('input',()=>{options();render()});byId('task-select').addEventListener('change',e=>{selected=e.target.value;render()});for(const kind of ['train','test'])byId(kind+'-toggle').addEventListener('click',()=>{split=kind;for(const v of ['train','test'])byId(v+'-toggle').setAttribute('aria-pressed',String(v===kind));render()});window.addEventListener('resize',render);options();render();
window.g64Dashboard={visible,render,data:D};
})();
</script></body></html>
