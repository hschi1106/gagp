    },
    "max_scheme_nesting": 0
  },
  "builtins": {
    "abs": true,
    "append": false,
    "char_to_string": false,
    "chr": false,
    "clip": true,
    "concat": true,
    "contains": true,
    "find": true,
    "idiv0": false,
    "imod0": false,
    "index": true,
    "is_digit": false,
    "is_letter": false,
    "is_space": false,
    "is_vowel": false,
    "len": true,
    "max": true,
    "min": true,
    "ord": false,
    "prepend": false,
    "reverse": true,
    "singleton": false,
    "slice": true,
    "string_to_char": false,
    "to_lower": false,
    "to_string": false,
    "to_upper": false
  },
  "compat": null,
  "expressions": {
    "asgp_dc": false,
    "asgp_dp1d": false,
    "asgp_dp2d": false,
    "binary": true,
